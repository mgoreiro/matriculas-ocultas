# Configuración del servicio de contacto (server/contacto.py).
# Servidor: /etc/matriculas-contacto.env (lo crea deploy/preparar-servidor.sh) · Local: copia a .env
# Nunca lo subas a git. Documentación de cada variable: README.md → «Formulario de contacto».
CONTACT_TO=mgoreiro@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
# Contraseña de aplicación de Gmail (sin espacios o entre comillas)
SMTP_PASSWORD=contraseña_de_aplicación
# user = From es el correo del visitante · server = From es tu cuenta (mejor entrega)
FROM_MODE=user
# Pruebas sin enviar (el correo se escribe en el log):
# MAIL_DRY_RUN=1
