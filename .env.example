# Copia a .env (desarrollo) o a /etc/matriculas-contacto.env (servidor). Nunca lo subas a git.
CONTACT_TO=mgoreiro@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASSWORD=contraseña_de_aplicación
# user = el remitente (From) será el correo que escribe el visitante; server = tu cuenta (mejor entrega)
FROM_MODE=user
# MAIL_DRY_RUN=1
